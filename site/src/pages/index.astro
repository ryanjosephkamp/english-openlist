---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Search from '../islands/Search.tsx';
import { manifest, stats, runs, fmt, publishedOn, DECIDED_LABEL, DECIDED_WHAT, HF } from '../util/data';
import { usDate } from '../util/dates';

const maxLength = stats.lengths[stats.lengths.length - 1]!.length;
const lastPublished = usDate(publishedOn);

// Words to start from, chosen from a vetted list of examples; the build fails
// if one leaves the list.
const EXAMPLES = ['steamship', 'epiphysis', 'trehalose', 'mainmast', 'remittance', 'capsaicin', 'autophagy', 'regift'];
---

<Base
  title="Search"
  section="Search"
  description={`Search and filter the English OpenList: ${fmt(manifest.wordCount)} English words, lowercase a to z, in your browser.`}
>
  <div class="frame home">
    <header class="home-head">
      <Mark size={56} />
      <div>
        <h1>English OpenList</h1>
        <p class="lede">
          A free list of <strong class="n">{fmt(manifest.wordCount)}</strong> English words, lowercase a to z only, for word
          games and apps, research, and teaching. The whole list loads into this page, so every search runs in your browser.
        </p>
        <p class="home-sub">
          This is the list as published on {lastPublished}. Its files are on
          <a href={HF} rel="noopener">Hugging Face</a>; <a href="/rule/">its rule and record</a> say what is on it and why, and
          <a href="/blog/">the daily log</a> shows what each night's run added.
        </p>
      </div>
    </header>

    <Search
      client:load
      decidedLabels={DECIDED_LABEL}
      decidedWhat={DECIDED_WHAT}
      decidedCounts={stats.decided}
      runDates={runs.map((r) => r.date)}
      bulkDates={manifest.bulkDates.map((b) => b.date)}
      maxLength={maxLength}
      examples={EXAMPLES}
    />
  </div>
</Base>

<style>
  .home {
    display: grid;
    gap: var(--space-7);
  }
  .home-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  .home-head :global(.mark) {
    margin-top: 0.4rem;
  }
  .home-head > div {
    display: grid;
    gap: var(--space-3);
  }
  h1 {
    font-size: var(--step-5);
  }
  .lede .n {
    color: var(--accent);
    font-weight: 600;
  }
  .home-sub {
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  @media (max-width: 36rem) {
    .home-head {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .home-head :global(.mark) {
      width: 40px;
      height: 40px;
    }
    h1 {
      font-size: var(--step-4);
    }
  }
</style>
